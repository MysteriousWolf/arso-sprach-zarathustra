[Unit]
Description=ARSO Discord weather bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=YOUR_LINUX_USER
ExecStart=/home/YOUR_LINUX_USER/.local/bin/arso-sprach-zarathustra
Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
